{
    //////////////////////////////
    //#region Language Settings //
    //////////////////////////////
    "[ansible]": {
        // "editor.defaultFormatter": "redhat.ansible",
        "editor.formatOnPaste": true,
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.renderWhitespace": "trailing"
    },
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format",
    },
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[markdown]": {
        "editor.wordWrap": "wordWrapColumn",
        "editor.wordWrapColumn": 120
    },
    "[properties]": {
        "editor.bracketPairColorization.enabled": true,
        "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?"
    },
    "[python]": {
        "editor.formatOnType": true,
        "editor.formatOnSave": true,
        // Indentation Guides
        "editor.guides.indentation": true,
        "editor.guides.highlightActiveIndentation": true,
        "editor.defaultFormatter": "ms-python.black-formatter",
    },
    "C_Cpp.intelliSenseEngine": "disabled",
    //#endregion
    /////////////////////////////
    //#region General Settings //
    /////////////////////////////
    "update.showReleaseNotes": false,
    "telemetry.feedback.enabled": false,
    //#region > Chat
    "chat.agent.enabled": false,
    "chat.commandCenter.enabled": false,
    //#endregion
    //#region > Color/Theme
    "workbench.colorTheme": "Material Candy",
    //#region >> Workbench Color Customizations
    "workbench.colorCustomizations": {
        "[Material Candy]": {
            // editor
            "breadcrumb.foreground": "#007744",
            "dropdown.background": "#050505",
            "editorLineNumber.foreground": "#007744",
            "editorLineNumber.activeForeground": "#00DDAA",
            "editor.background": "#000000",
            "input.background": "#050505",
            // menus
            "badge.background": "#110022",
            "banner.background": "#000000",
            "button.background": "#000000",
            "menu.background": "#050505",
            // panel
            "panel.background": "#000000",
            // side bar
            "activityBar.background": "#000000",
            "activityBar.border": "#050505",
            "sideBar.background": "#000000",
            "sideBar.border": "#111111",
            "statusBar.background": "#001133",
            "statusBarItem.remoteBackground": "#005533",
            // tab bar
            // "tab.activeBackground": "#122412",
            "editorGroupHeader.tabsBackground": "#000000",
            "tab.activeBackground": "#181818",
            //     "tab.activeBackground": "#121a24"
            "tab.activeForeground": "#00DDAA",
            "tab.inactiveBackground": "#000000",
            "tab.border": "#111111",
            "titleBar.activeBackground": "#000000",
            // window
        },
        "[Sweet vscode]": {
            "input.background": "#000000",
            "menu.background": "#000000",
            "panel.background": "#000000",
            "sideBar.background": "#000000"
        }
    },
    //#endregion
    //#region >> Token Color Customizations
    "editor.semanticTokenColorCustomizations": {
        "[Material Candy]": {
            "enabled": true,
            "rules": {}
        }
    },
    //#region Custom Color Codes
    //#endregion
    "editor.tokenColorCustomizations": {
        // General
        "comments": "#009900",
        // Theme Specific
        "[Material Candy]": {},
        // Textmate
        "textMateRules": [
            //#region >>> C++
            // Bold function declaration lines
            {
                "scope": "entity.name.function.definition.cpp",
                "settings": {
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "entity.name.scope-resolution.function.definition.cpp",
                "settings": {
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "punctuation.separator.scope-resolution.function.definition.cpp",
                "settings": {
                    "fontStyle": "bold"
                }
            },
            //
            //#endregion
            //#region >>> toml
            {
                "scope": "support.type.property-name.table.toml",
                "settings": {
                    "foreground": "#ff9e27",
                    "fontStyle": "bold"
                }
            },
            //#endregion
            //#region >>> Generic
            {
                "scope": "keyword.control.ref.properties",
                "settings": {
                    "foreground": "#FF0000"
                }
            },
            // Entities
            {
                "scope": "entity.name.section.group-title.ini",
                "settings": {
                    "foreground": "#65ff51"
                }
            },
            // Comments
            {
                "scope": "comment.line.number-sign.ini",
                "settings": {
                    "foreground": "#1a5200"
                }
            },
            // Constants
            {
                "scope": "constant.language",
                "settings": {
                    "foreground": "#009dff",
                    "fontStyle": "italic"
                }
            },
            // Separators
            {
                "scope": "keyword.other.separator",
                "settings": {
                    "foreground": "#FF8C00"
                }
            },
            {
                "scope": "punctuation.separator.key-value.ini",
                "settings": {
                    "foreground": "#FF8C00"
                }
            },
            {
                "scope": "punctuation.separator.option.ini",
                "settings": {
                    "foreground": "#0048ff"
                }
            },
            // Options
            {
                "scope": "string.other.option",
                "settings": {
                    "foreground": "#006eff"
                }
            },
            {
                "scope": "keyword.other.definition.ini",
                "settings": {
                    "foreground": "#009dff"
                }
            },
            //#endregion
            //#region >>> Log
            {
                "scope": "log.info",
                "settings": {
                    "foreground": "#00ff0d",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "log.debug",
                "settings": {
                    "foreground": "#eeff00",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "log.warning",
                "settings": {
                    "foreground": "#ff4400",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "log.error",
                "settings": {
                    "foreground": "#FF0000",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "log.exceptiontype",
                "settings": {
                    "foreground": "#ff2a00",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": "log.string",
                "settings": {
                    "foreground": "#FF8C00",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": "text.log",
                "settings": {
                    "foreground": "#00d7ac"
                }
            }
            //#endregion
        ]
    },
    //#endregion
    //#endregion
    //#region > Workbench
    "workbench.startupEditor": "none",
    //#region >> Side Bar Settings
    "workbench.secondarySideBar.showLabels": false,
    "workbench.sideBar.location": "right",
    //#endregion
    //#region >> Tab Settings
    "workbench.editor.pinnedTabSizing": "compact",
    "workbench.editor.pinnedTabsOnSeparateRow": true,
    //#endregion
    //#endregion
    //#region > Editor
    "editor.acceptSuggestionOnEnter": "off",
    "editor.accessibilitySupport": "off",
    "editor.inlayHints.enabled": "off",
    "editor.tabCompletion": "on",
    // Bracket Pairs
    "editor.guides.bracketPairs": true,
    "editor.bracketPairColorization.enabled": true,
    //#region >> Font
    "editor.fontSize": 13.50,
    "editor.fontFamily": "'Mensch Nerd Font', 'MesloLGS Nerd Font Propo', 'IntoneMono NF', 'JetBrains Mono', 'Droid Sans Mono', 'monospace'",
    "editor.fontLigatures": true,
    "editor.codeLensFontFamily": "'Lilex Nerd Font', 'IntoneMono NF', 'JetBrains Mono'",
    //#endregion
    //#region >> View
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.guides.indentation": false,
    "editor.minimap.enabled": false,
    "editor.minimap.autohide": "none",
    "editor.minimap.maxColumn": 80,
    "editor.minimap.scale": 1,
    "editor.minimap.side": "right",
    "editor.renderLineHighlight": "all",
    "editor.rulers": [
        {
            "column": 140,
            "color": "#1b1b1b"
        }
    ],
    "editor.stickyScroll.defaultModel": "foldingProviderModel",
    "editor.unicodeHighlight.nonBasicASCII": false,
    //#endregion
    //#region >> Formatting
    "editor.defaultFormatter": "xaver.clang-format",
    // "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "modificationsIfAvailable",
    "editor.wrappingIndent": "indent",
    //#endregion
    //#endregion
    //#region > Files
    "files.associations": {
        "*.yaml": "yaml",
        "*.inc": "cpp",
        "*.tcc": "cpp",
        ".clangd": "yaml",
        "*.textProto": "prototxt"
    },
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    //#endregion
    //#region > Notebook
    "notebook.output.textLineLimit": 300,
    //#endregion
    //#region > Remote
    "remote.SSH.experimental.chat": false,
    "remote.SSH.remotePlatform": {},
    "remote.defaultExtensionsIfInstalledLocally": [],
    "security.allowedUNCHosts": [],
    //#endregion
    //#region > Task
    "task.allowAutomaticTasks": "on",
    //#endregion
    //#region > Terminal
    "terminal.integrated.stickyScroll.enabled": true,
    "terminal.external.linuxExec": "wezterm",
    "terminal.integrated.automationProfile.linux": {
        "path": "/usr/local/bin/zellij",
        "args": [
            "--session",
            "dev",
            "run",
            "--floating",
            "--width",
            "96%",
            "--x",
            "2%",
            "--height",
            "60%",
            "--y",
            "10%",
            "--",
            "/usr/bin/fish",
            "-c"
        ],
    },
    "terminal.integrated.profiles.linux": {
        "fish": {
            "path": "/usr/bin/fish"
        },
        "zellij": {
            "path": "/usr/local/bin/zellij",
            "icon": "terminal-tmux"
        },
        "wezterm-zellij-dev": {
            "path": "/usr/local/bin/zellij",
            "args": [
                "run",
                "--in-place",
                "--",
                "$command"
            ]
        }
    },
    //#endregion
    //#region > Window
    "window.closeWhenEmpty": true,
    "window.menuBarVisibility": "toggle",
    "window.title": "[${profileName}]${separator}<${rootName}>${separator}${rootPath}",
    //#endregion
    //#endregion
    ///////////////////////////////
    //#region Extension Settings //
    ///////////////////////////////
    //#region > Arduino
    "arduino.enableUSBDetection": true,
    "arduino.useArduinoCli": true,
    //#endregion
    //#region > BetterComments
    // "better-comments.multilineComments": true,
    "better-comments.fullHighlight": true,
    "better-comments.tags": [
        {
            "tag": "!",
            "color": "#FF2D00",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false,
            "multiline": true
        },
        {
            "tag": "?",
            "color": "#3498DB",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false,
            "multiline": true
        },
        {
            "tag": " //",
            "color": "#474747",
            "strikethrough": true,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "//",
            "color": "#16e06e"
        },
        {
            "tag": "#",
            "color": "#16e06e"
        },
        {
            "tag": "todo",
            "color": "#FF8C00",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false,
            "multiline": true
        },
        {
            "tag": "temp",
            "color": "#D47C00",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "#004977",
            "bold": true,
            "italic": false
        }
    ],
    //#endregion
    //#region > Bookmarks
    "bookmarks.showCommandsInContextMenu": false,
    //#endregion
    //#region > Clangd
    "clangd.arguments": [
        "--header-insertion=never",
    ],
    //#endregion
    //#region > CMake
    "cmake.configureOnOpen": true,
    "cmake.pinnedCommands": [
        "workbench.action.tasks.configureTaskRunner",
        "workbench.action.tasks.runTask"
    ],
    "cmake.showOptionsMovedNotification": false,
    //#endregion
    //#region > CSpell
    "cSpell.language": "en,en-US",
    "cSpell.userWords": [
        "chezmoi",
        "constexpr",
        "CRTP",
        "gifs",
        "hellscape",
        "Karolinska",
        "nullpointer",
        "PIPC",
        "Struct",
        "Telematics",
        "TOTP",
        "VRTE",
        "wezterm"
    ],
    //#endregion
    //#region > Docker
    "docker.extension.enableComposeLanguageServer": false,
    //#endregion
    //#region > DoxygenDocumentationGenerator
    "doxdocgen.c.triggerSequence": "///",
    "doxdocgen.generic.useGitUserEmail": true,
    "doxdocgen.generic.useGitUserName": true,
    "doxdocgen.generic.briefTemplate": "@brief ${cursor}",
    "doxdocgen.generic.paramTemplate": "@param {direction}{align:1} {param}{align:2} ${cursor}",
    "doxdocgen.generic.returnTemplate": "@return {type} ${cursor}",
    //#endregion
    //#region > Git
    "git.autofetch": true,
    "git.blame.editorDecoration.enabled": false,
    "git.blame.statusBarItem.enabled": false,
    "git.openRepositoryInParentFolders": "always",
    //#endregion
    //#region > Github Copilot
    "github.copilot.enable": {
        "*": false,
    },
    //#endregion
    //#region > Github Pull Requests
    "githubPullRequests.assignCreated": "${user}",
    "githubPullRequests.commentExpandState": "collapseAll",
    //#endregion
    //#region > Gitlens
    "gitlens.autolinks": [
        // {
        // "prefix": "PROJECT-",
        // "url": "https://your-company.atlassian.net/browse/PROJECT-<num>"
        // }
    ],
    "gitlens.plusFeatures.enabled": false,
    "gitlens.telemetry.enabled": false,
    //#endregion
    //#region > GlassIt
    "glassit.alpha": 250,
    //#endregion
    //#region > HeaderSourceSwitch
    "headerSourceSwitch.mappings": [
        {
            "header": [
                ".h",
                ".hpp",
                ".hh",
                ".hxx"
            ],
            "source": [
                ".cpp",
                ".c",
                ".cc",
                ".cxx",
                ".inc",
                ".m",
                ".mm",
                ".tcc"
            ],
            "name": "C++"
        }
    ],
    //#endregion
    //#region > Python
    "python.analysis.typeCheckingMode": "standard",
    //#endregion
    //#region > Redhat
    "redhat.telemetry.enabled": false,
    //#endregion
    //#region > Shellcheck
    "shellcheck.customArgs": [
        "--enable=all"
    ],
    //#endregion
    //#region > Todo Tree
    "todo-tree.regex.enableMultiLine": true,
    "todo-tree.general.tags": [
        "BUG",
        "HACK",
        "FIXME",
        "TODO",
        "TODO:",
        "XXX",
        "[ ]",
        "[x]"
    ],
    "todo-tree.general.tagGroups": {
        "TODO": [
            "TODO",
            "TODO:"
        ]
    },
    "todo-tree.highlights.defaultHighlight": {
        "icon": "checklist",
        "gutterIcon": true,
        "iconColour": "#FF8C00",
        "type": "tag",
        "foreground": "#000000",
        "background": "#FF8C00",
    },
    //#endregion
    //#region > YAML
    "yaml.format.singleQuote": true,
    "yaml.schemas": {
        // "URL": [
        //     "folder/**/*-filepattern-*.yaml"
        // ]
    },
    //#endregion
    //#endregion
    ///////////////////////////////
    //#region Set Elsewhere      //
    ///////////////////////////////
    // These settings are likely set from outside the json. Provided their own section so they don't get mixed up with other sections
    // These will need to be manually moved to the correct section
    // #endregion
    ///////////////////////////////
}
